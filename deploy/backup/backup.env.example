# AssurMatch offsite backup settings (spec 058 FR-005) — copy to /etc/assurmatch/backup.env,
# owner root, mode 0600. Read by scripts/ops/backup-offsite.sh and restore-offsite.sh.
# Secrets stay REDACTED in the repository.

# Source database (read-only role recommended: pg_dump needs SELECT on every table).
DATABASE_URL=REDACTED
# Local document storage only (ASSURMATCH_DOCUMENT_STORAGE=local). Leave empty with S3 storage:
# the documents bucket has its own versioning/replication.
UPLOADS_DIR=
BACKUP_WORK_DIR=/var/backups/assurmatch/work

# Encryption: age public recipients (the private identity is kept OFFLINE by two custodians).
BACKUP_AGE_RECIPIENTS_FILE=/etc/assurmatch/backup-recipients.txt
# Fallback only (symmetric): a file holding the passphrase, mode 0600.
BACKUP_GPG_PASSPHRASE_FILE=

# S3-compatible storage in ANOTHER provider/region than the production host.
BACKUP_S3_ENDPOINT=https://s3.fr-par.scw.cloud
BACKUP_S3_REGION=fr-par
BACKUP_S3_BUCKET=assurmatch-backups
BACKUP_S3_PREFIX=assurmatch/production
# Key restricted to this bucket (put/get/list/delete), no other permission.
BACKUP_S3_ACCESS_KEY_ID=REDACTED
BACKUP_S3_SECRET_ACCESS_KEY=REDACTED
BACKUP_RETENTION_DAYS=30

# Optional Uptime Kuma "Push" URL (credential: never committed). Empty: no push.
BACKUP_PUSH_URL=
