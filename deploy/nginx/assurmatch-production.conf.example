# AssurMatch production reverse proxy — TEMPLATE (spec 057). Domain not decided yet (D-10):
# replace every <domain> (e.g. `sed 's/<domain>/assurmatch.example/g'`) and save as
# deploy/nginx/assurmatch-production.conf (host nginx: /etc/nginx/sites-available/assurmatch).
#
# Four sub-domains, four upstreams, TLS terminated here:
#   <domain>        Web Publique Client      :3601
#   admin.<domain>  Back-office Plateforme   :3602
#   pro.<domain>    Broker Back-office       :3603
#   api.<domain>    Backend API              :3600
#
# Host nginx (default topology): upstreams on 127.0.0.1. With the compose `edge` profile, use the
# service names instead (api:3600, public:3601, admin:3602, broker:3603).
# The API counts ONE trusted hop (TRUSTED_PROXY_HOPS=1): this proxy. Behind a CDN/load balancer
# that also appends X-Forwarded-For, raise TRUSTED_PROXY_HOPS accordingly.
# Full security headers (CSP per app, etc.) are versioned by spec 058.

upstream assurmatch_api    { server 127.0.0.1:3600; }
upstream assurmatch_public { server 127.0.0.1:3601; }
upstream assurmatch_admin  { server 127.0.0.1:3602; }
upstream assurmatch_broker { server 127.0.0.1:3603; }

server {
    listen 80;
    server_name <domain> admin.<domain> pro.<domain> api.<domain>;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

# --- Public -----------------------------------------------------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name <domain>;
    ssl_certificate     /etc/letsencrypt/live/<domain>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/<domain>/privkey.pem;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location / {
        proxy_pass http://assurmatch_public;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# --- Back-office Plateforme -------------------------------------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name admin.<domain>;
    ssl_certificate     /etc/letsencrypt/live/admin.<domain>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin.<domain>/privkey.pem;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;
    add_header X-Robots-Tag "noindex, nofollow" always;

    location / {
        proxy_pass http://assurmatch_admin;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# --- Broker Back-office -----------------------------------------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name pro.<domain>;
    ssl_certificate     /etc/letsencrypt/live/pro.<domain>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pro.<domain>/privkey.pem;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;
    add_header X-Robots-Tag "noindex, nofollow" always;

    location / {
        proxy_pass http://assurmatch_broker;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# --- API --------------------------------------------------------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name api.<domain>;
    ssl_certificate     /etc/letsencrypt/live/api.<domain>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.<domain>/privkey.pem;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    client_max_body_size 12m;

    location / {
        proxy_pass http://assurmatch_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
