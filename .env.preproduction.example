# AssurMatch preproduction example. NEVER commit a filled .env.preproduction.
# All secrets stay in /home/deployer/apps/assurmatch/.env.production on the VPS, mode 0600.

NODE_ENV=production
APP_ENV=preproduction

# Container ports - must match the deployment topology B
PORT=3600
PUBLIC_PORT=3601
BACKOFFICE_PORT=3602

# Public URLs (sub-domain layout, Nginx terminates HTTPS)
APP_BASE_URL=https://assurmatch.allianceconsultants.net
PUBLIC_APP_URL=https://assurmatch.allianceconsultants.net
BACKOFFICE_APP_URL=https://backoffice-assurmatch.allianceconsultants.net
API_BASE_URL=https://api-assurmatch.allianceconsultants.net
CORS_ORIGINS=https://assurmatch.allianceconsultants.net,https://backoffice-assurmatch.allianceconsultants.net
COOKIE_DOMAIN=.allianceconsultants.net

# Database and queues - values filled on VPS only
DATABASE_URL=REDACTED
REDIS_URL=REDACTED
BULLMQ_PREFIX=assurmatch-preproduction

# Auth and encryption - generate with: openssl rand -base64 48
SESSION_SECRET=REDACTED
JWT_SECRET=REDACTED
ASSURMATCH_AUTH_TOKEN_SECRET=REDACTED
ENCRYPTION_KEY=REDACTED
AUTH_JWT_TTL_MINUTES=15
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_WINDOW_MINUTES=15
AUTH_LOCKOUT_COOLDOWN_MINUTES=30

# Storage
LOCAL_STORAGE_ROOT=/app/uploads
S3_ENDPOINT=http://minio:9000
S3_BUCKET=assurmatch-preproduction
S3_ACCESS_KEY_ID=REDACTED
S3_SECRET_ACCESS_KEY=REDACTED

# Logging and rate limits
LOG_LEVEL=info
RATE_LIMIT_GLOBAL_PER_MIN=600
RATE_LIMIT_PUBLIC_PER_IP_PER_MIN=60
RATE_LIMIT_QUOTE_PER_IP_PER_HOUR=10

# Memory adapters MUST stay false in preprod and production
ASSURMATCH_PRISMA_MEMORY=false
ASSURMATCH_REDIS_MEMORY=false
ASSURMATCH_QUEUE_MEMORY=false
ASSURMATCH_AUDIT_MEMORY=false

# Email. Keep preview mode true until an operator explicitly validates delivery.
EMAIL_SERVICE_TYPE=smtp
EMAIL_FROM=no-reply@assurmatch.local
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=REDACTED
EMAIL_SMTP_PASS=REDACTED
EMAIL_REPLY_TO=support@assurmatch.local
EMAIL_SEND_TIMEOUT_MS=5000
EMAIL_PREVIEW_MODE=true

# Backups
BACKUP_PASSPHRASE=REDACTED

# Monitoring (optional)
SENTRY_DSN=
UPTIME_KUMA_PUSH_URL=

# Feature flags - all sensitive flags MUST stay false. Activation is audited per scope.
MFA_REQUIRED=true
PUBLIC_COMPARATOR_ENABLED=false
QUOTE_REQUEST_ENABLED=false
STARTER_PORTAL_ENABLED=false
BROKER_CRM_ENABLED=false
BROKER_DASHBOARD_ENABLED=false
BILLING_ENABLED=false
PAYMENTS_ENABLED=false
E_SIGNATURE_ENABLED=false
POLICY_ISSUANCE_ENABLED=false
CLAIMS_ENABLED=false
INSURER_API_ENABLED=false
WHATSAPP_ENABLED=false
AI_LEAD_SCORING_ENABLED=false
AI_SUMMARY_ENABLED=false
AI_DUPLICATE_DETECTION_ENABLED=false
AI_RECOMMENDATION_ENABLED=false
AI_BROKER_ASSISTANT_ENABLED=false
SPONSORED_OFFERS_ENABLED=false
MULTI_BROKER_ROUTING_ENABLED=false
