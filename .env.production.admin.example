# AssurMatch PRODUCTION — Back-office Plateforme/Admin container (spec 057, PRD K-06).
# On the host: /home/deployer/apps/assurmatch/env/admin.env. NO SECRET belongs here: the admin
# app talks to the API with the user's session token only. Never give it DATABASE_URL (the demo
# login picker that reads it is local-only).
#
# NEXT_PUBLIC_* values are compiled into the image by `next build` (CI build arguments from the
# GitHub variable PROD_API_URL). Repeated here for reference only.

NODE_ENV=production
APP_ENV=production

NEXT_PUBLIC_ASSURMATCH_API_URL=https://api.<domain>
NEXT_PUBLIC_ASSURMATCH_ADMIN_API_URL=https://api.<domain>
