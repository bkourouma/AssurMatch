# AssurMatch PRODUCTION — API container (spec 057). NEVER commit a filled copy.
# On the host: /home/deployer/apps/assurmatch/env/api.env, owner deployer, mode 0600.
# Every variable below is read by the code; nothing else is needed. Domains are placeholders
# (decision D-10: production domain not decided yet) - replace <domain> everywhere.

NODE_ENV=production
APP_ENV=production
PORT=3600

# --- Data stores -------------------------------------------------------------------------------
DATABASE_URL=REDACTED
REDIS_URL=redis://redis:6379
# Read by the config module but unused since decision D-7 (no BullMQ queue left). Keep or drop.
BULLMQ_PREFIX=assurmatch-production

# --- Secrets (generate with: openssl rand -base64 48) ------------------------------------------
# Signs back-office session tokens; at least 32 characters, otherwise no login is possible.
ASSURMATCH_AUTH_TOKEN_SECRET=REDACTED
# Encrypts MFA secrets and partner integration secrets; at least 32 bytes (boot fails otherwise).
ENCRYPTION_KEY=REDACTED
AUTH_JWT_TTL_MINUTES=15
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_WINDOW_MINUTES=15
AUTH_LOCKOUT_COOLDOWN_MINUTES=30

# --- HTTP edge ---------------------------------------------------------------------------------
# Browser origins allowed to call the API (the public site only; back-offices call server-side).
CORS_ORIGINS=https://<domain>
# Reverse proxies in front of the API that append to X-Forwarded-For (nginx = 1). 0 = none.
TRUSTED_PROXY_HOPS=1

# --- Links written into e-mails ------------------------------------------------------------------
# Back-office admin URL: activation and password-reset links.
APP_BASE_URL=https://admin.<domain>
# Public site URL: visitor tracking links.
PUBLIC_APP_URL=https://<domain>
# Broker back-office URL: broker lead links.
BROKER_APP_URL=https://pro.<domain>

# --- Transactional e-mail (PRD K-08) -----------------------------------------------------------
# Professional provider with SPF/DKIM/DMARC aligned on the sender domain. mailpit is refused in
# production. Keep EMAIL_PREVIEW_MODE=true until an operator has validated real delivery.
EMAIL_SERVICE_TYPE=smtp
EMAIL_FROM=no-reply@<domain>
EMAIL_REPLY_TO=support@<domain>
EMAIL_SMTP_HOST=REDACTED
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=REDACTED
EMAIL_SMTP_PASS=REDACTED
EMAIL_SEND_TIMEOUT_MS=5000
EMAIL_PREVIEW_MODE=true

# --- Documents: S3 storage + ClamAV (PRD K-07) -------------------------------------------------
# Uploads stay refused until durable storage is configured; s3 and clamav are mandatory as soon
# as any upload feature is enabled.
ASSURMATCH_DOCUMENT_STORAGE=s3
ASSURMATCH_S3_ENDPOINT=https://<s3-endpoint>
ASSURMATCH_S3_BUCKET=assurmatch-production-documents
ASSURMATCH_S3_REGION=REDACTED
ASSURMATCH_S3_ACCESS_KEY_ID=REDACTED
ASSURMATCH_S3_SECRET_ACCESS_KEY=REDACTED
ASSURMATCH_ANTIVIRUS=clamav
ASSURMATCH_CLAMAV_HOST=clamav
ASSURMATCH_CLAMAV_PORT=3310

# --- AI (constitution V: assisted, audited; deterministic template by default) -----------------
ASSURMATCH_AI_PROVIDER=template
# With ASSURMATCH_AI_PROVIDER=anthropic only (leave commented otherwise: an empty value is not a default):
# ANTHROPIC_API_KEY=REDACTED
# ASSURMATCH_AI_MODEL=
# ASSURMATCH_AI_FALLBACKS=true
# ASSURMATCH_AI_TIMEOUT_MS=60000

# --- Messaging providers (status shown in the admin; sending stays flag-gated) -----------------
# ASSURMATCH_SMS_PROVIDER=
# ASSURMATCH_SMS_API_KEY=REDACTED
# ASSURMATCH_WHATSAPP_PROVIDER=
# ASSURMATCH_WHATSAPP_API_KEY=REDACTED

# --- Visitor follow-up token lifetime (spec 054) ----------------------------------------------
ASSURMATCH_VISITOR_TOKEN_TTL_DAYS=30

# --- B2B invoicing (spec 060, research R-4) -----------------------------------------------------
# Issuer legal mentions printed on every issued invoice. In production an invoice is refused while a
# required mention (legal name, address, RCCM, tax id) is missing. A country-specific value
# (ASSURMATCH_INVOICE_CI_ISSUER_TAX_ID, ASSURMATCH_INVOICE_SN_ISSUER_RCCM...) overrides the global one.
# The VAT rates must be validated by the accounting team before the first issue.
ASSURMATCH_INVOICE_ISSUER_LEGAL_NAME=
ASSURMATCH_INVOICE_ISSUER_ADDRESS=
ASSURMATCH_INVOICE_ISSUER_RCCM=
ASSURMATCH_INVOICE_ISSUER_TAX_ID=
ASSURMATCH_INVOICE_ISSUER_EMAIL=
ASSURMATCH_INVOICE_ISSUER_PAYMENT_INSTRUCTIONS=
ASSURMATCH_INVOICE_CI_VAT_RATE=18
ASSURMATCH_INVOICE_SN_VAT_RATE=18
ASSURMATCH_INVOICE_PAYMENT_TERM_DAYS=30

# Feature flags live in the database and are changed from the admin, audited. The only env
# switches read by the code are listed here and must stay false at launch.
PUBLIC_COMPARATOR_ENABLED=false
QUOTE_REQUEST_ENABLED=false
WHATSAPP_ENABLED=false

# Forbidden in production: ASSURMATCH_*_MEMORY=true and LOCAL_BOOTSTRAP_ADMIN_* (boot fails),
# ASSURMATCH_ALLOW_TEST_AUTH_HEADERS (test-only, ignored outside NODE_ENV=test). Create the first Super Admin with
# `npm run ops:bootstrap-super-admin` (docs/runbooks/bootstrap-admin.md).
