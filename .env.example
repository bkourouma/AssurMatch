NODE_ENV=local
APP_ENV=local
PORT=3600
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3600
PUBLIC_APP_URL=http://localhost:3601
BACKOFFICE_APP_URL=http://localhost:3602
CORS_ORIGINS=http://localhost:3601,http://localhost:3602
COOKIE_DOMAIN=
DATABASE_URL=postgresql://assurmatch:assurmatch@localhost:5432/assurmatch
REDIS_URL=redis://localhost:6379
BULLMQ_PREFIX=assurmatch
LOCAL_STORAGE_ROOT=./tmp/uploads
LOG_LEVEL=info
RATE_LIMIT_GLOBAL_PER_MIN=600
RATE_LIMIT_PUBLIC_PER_IP_PER_MIN=60
RATE_LIMIT_QUOTE_PER_IP_PER_HOUR=10
# Memory adapters are allowed only in explicit test runtime.
ASSURMATCH_PRISMA_MEMORY=false
ASSURMATCH_REDIS_MEMORY=false
ASSURMATCH_QUEUE_MEMORY=false
ASSURMATCH_AUDIT_MEMORY=false
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=assurmatch-local
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
SESSION_SECRET=replace-with-local-secret-only
JWT_SECRET=replace-with-local-secret-only
ASSURMATCH_AUTH_TOKEN_SECRET=replace-with-32-plus-character-local-secret
ENCRYPTION_KEY=replace-with-32-plus-character-local-encryption-key
AUTH_JWT_TTL_MINUTES=15
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_WINDOW_MINUTES=15
AUTH_LOCKOUT_COOLDOWN_MINUTES=30
# Email delivery is disabled by default. Use mailpit locally/preprod, SMTP only
# with runtime-provided secrets. Never commit a real EMAIL_SMTP_PASS.
EMAIL_SERVICE_TYPE=disabled
EMAIL_FROM=no-reply@assurmatch.local
EMAIL_SMTP_HOST=127.0.0.1
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=REDACTED
EMAIL_SMTP_PASS=REDACTED
EMAIL_REPLY_TO=support@assurmatch.local
EMAIL_SEND_TIMEOUT_MS=5000
EMAIL_PREVIEW_MODE=true
# AUTH_PASSWORD_DENYLIST_PATH=backend/src/modules/auth/password-deny-list.ts
# LOCAL_BOOTSTRAP_ADMIN_EMAIL=admin@assurmatch.local
# LOCAL_BOOTSTRAP_ADMIN_PASSWORD=replace-with-12-plus-character-password
MFA_REQUIRED=true
PUBLIC_COMPARATOR_ENABLED=false
QUOTE_REQUEST_ENABLED=false
STARTER_PORTAL_ENABLED=false
BROKER_CRM_ENABLED=false
BROKER_DASHBOARD_ENABLED=false
BILLING_ENABLED=false
PAYMENTS_ENABLED=false
E_SIGNATURE_ENABLED=false
POLICY_ISSUANCE_ENABLED=false
CLAIMS_ENABLED=false
INSURER_API_ENABLED=false
WHATSAPP_ENABLED=false
AI_LEAD_SCORING_ENABLED=false
AI_SUMMARY_ENABLED=false
AI_DUPLICATE_DETECTION_ENABLED=false
AI_RECOMMENDATION_ENABLED=false
AI_BROKER_ASSISTANT_ENABLED=false
# Backups (used on the VPS; locally optional)
BACKUP_PASSPHRASE=
# Monitoring (optional)
SENTRY_DSN=
UPTIME_KUMA_PUSH_URL=
SPONSORED_OFFERS_ENABLED=false
MULTI_BROKER_ROUTING_ENABLED=false
