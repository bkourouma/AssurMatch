{
  "name": "assurmatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "workspaces": [
    "apps/*",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.base.json --noEmit",
    "typecheck": "tsc -p tsconfig.base.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run backend/tests/unit",
    "test:integration": "vitest run backend/tests/integration",
    "test:contract": "vitest run backend/tests/contract",
    "test:guardrails": "vitest run backend/tests/guardrails",
    "test:runtime:postgres": "node scripts/runtime-smoke/runtime-smoke-run.mjs",
    "test:runtime:postgres:direct": "node --import tsx backend/tests/runtime-postgres/run-runtime-postgres-smoke.ts",
    "test:runtime:postgres:up": "node scripts/runtime-smoke/runtime-smoke-up.mjs",
    "test:runtime:postgres:down": "node scripts/runtime-smoke/runtime-smoke-down.mjs",
    "test:runtime:postgres:clean": "node scripts/runtime-smoke/runtime-smoke-down.mjs --volumes",
    "test:runtime:postgres:docker": "node scripts/runtime-smoke/runtime-smoke-run.mjs --with-docker",
    "local:health": "node scripts/local-app/local-health.mjs",
    "local:seed:broker-demo": "node --import tsx scripts/local-app/seed-broker-demo.ts --apply",
    "local:seed:broker-demo:crm-off": "node --import tsx scripts/local-app/seed-broker-demo.ts --apply --crm-off",
    "ops:import:partners": "node --import tsx scripts/import-partners.ts",
    "ops:bootstrap-super-admin": "node --import tsx scripts/ops/bootstrap-super-admin.ts",
    "ops:apply-flag-policy": "node --import tsx scripts/ops/apply-flag-policy.ts",
    "worker:run": "node --import tsx scripts/worker/assurmatch-worker.ts",
    "test:web:local": "node scripts/local-app/local-browser-smoke.mjs",
    "test:web": "playwright test",
    "test:e2e:stack": "node scripts/e2e/e2e-stack.mjs",
    "test:e2e": "playwright test -c playwright.e2e.config.ts",
    "test:load": "node scripts/e2e/load-test.mjs",
    "partner-webhooks:deliver-due": "node --import tsx scripts/partner-webhook-delivery-worker.ts",
    "quote-notifications:deliver-due": "node --import tsx scripts/quote-notification-delivery-worker.ts",
    "seed:reference": "node --import tsx scripts/preprod/seed-reference.ts",
    "import:partners": "node --import tsx scripts/preprod/import-partners.ts",
    "validate": "npm run typecheck && npm run lint && npm run test",
    "satisfaction-surveys:deliver-due": "node --import tsx scripts/satisfaction-survey-delivery-worker.ts",
    "ops:verify-audit": "node --import tsx scripts/ops/verify-audit-integrity.ts",
    "ops:backfill-pii": "node --import tsx scripts/ops/backfill-pii-encryption.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "^0.45.1",
    "bullmq": "6.3.19",
    "lucide-react": "^1.57.0",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "otplib": "^13.5.0",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "redis": "6.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "eslint": "10.12.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@hono/node-server": "1.19.17",
    "deepmerge-ts": "8.0.2",
    "multer": "2.4.0",
    "mysql2": "3.24.4",
    "postcss": "8.5.28"
  },
  "prisma": {
    "seed": "tsx backend/prisma/seed.ts"
  }
}
