# AssurMatch PRODUCTION — Web Publique Client container (spec 057, PRD K-06).
# On the host: /home/deployer/apps/assurmatch/env/public.env. NO SECRET belongs here: this app is
# public and must never receive the API's database URL, tokens or keys.
#
# The NEXT_PUBLIC_* values are compiled into the image by `next build`; CI passes them as build
# arguments from the GitHub variables PROD_API_URL, PROD_PUBLIC_URL and PROD_BROKER_URL. They are
# repeated here for reference only - changing them here has no effect without a rebuild.

NODE_ENV=production

NEXT_PUBLIC_ASSURMATCH_API_URL=https://api.<domain>
NEXT_PUBLIC_ASSURMATCH_PUBLIC_URL=https://<domain>
NEXT_PUBLIC_ASSURMATCH_BROKER_URL=https://pro.<domain>
