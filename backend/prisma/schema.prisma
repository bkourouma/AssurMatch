  contactPhone            String
  whatsapp                String?
  desiredPlan             PartnerPlan              @default(starter)
  message                 String?
  consentVersion          String
  status                  PartnerApplicationStatus @default(received)
  reviewedById            String?
  reviewedAt              DateTime?
  reviewNote              String?
