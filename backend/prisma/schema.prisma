generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  invited
  active
  suspended
  locked
  deleted
}

enum MfaStatus {
  not_enrolled
  enrolled
  required
  verified
}

enum PartnerPlan {
  starter
  pro
  enterprise
}

/// Spec 051 R1: draft = Prospect, pending_compliance = En vérification, active_test = Actif test,
/// active = Actif public (the only routable and public status), suspended = Suspendu, retired = Résilié.
/// "Expiré" is computed from the licences, never stored.
enum PartnerStatus {
  draft
  pending_compliance
  active_test
  active
  suspended
  retired
}

enum CapacityStatus {
  available
  limited
  full
  blocked
}

enum CountryStatus {
  draft
  internal
  partner_test
  pilot
  public
  suspended
  retired
}

enum RegulatoryFamily {
  cima
  fanaf
  outside_cima
  future
}

enum RegimeStatus {
  draft
  active
  suspended
  retired
}

enum ProductCategoryStatus {
  draft
  active
  retired
}

enum ProductSensitivity {
  standard
  sensitive
  highly_sensitive
}

enum ProductStatus {
  draft
  internal
  pilot
  public
  suspended
  retired
}

enum LicenseStatus {
  draft
  pending_review
  valid
  expired
  suspended
  invalid
  revoked
  superseded
}

enum DocumentStatus {
  uploaded
  pending_review
  accepted
  rejected
  expired
  superseded
}

enum DocumentType {
  license
  registration
  identity
  mandate
  compliance_certificate
  partnership_contract
  other
}

/// Spec 051 R5: antivirus verdict of an accreditation document. Only `clean` files can be accepted or served.
enum AccreditationScanStatus {
  pending
  clean
  infected
  failed
}

enum FeatureFlagScopeType {
  global
  country
  product
  partner
  plan
  module
  ai
}

enum ConsentPurpose {
  lead_transmission
  document_upload
  technical_notification
  ai_processing
  marketing_optional
  service_quality_survey
}

enum ConsentChannel {
  public_web
  admin
  broker
  api
}

enum ConsentTextStatus {
  draft
  review
  published
  retired
}

enum ConsentRecordStatus {
  granted
  withdrawn
  expired
  anonymized
}

enum AuditResult {
  success
  refused
  failed
}

enum NotificationType {
  license_expiration_warning
  license_blocked
  partner_suspended
  feature_flag_changed
  critical_job_failed
  consent_text_changed
  security_admin_change
  visitor_quote_confirmation
  visitor_quote_non_routable
  broker_lead_assigned
  quote_notification_failed
  offer_validated
  offer_rejected
  offer_suspended
  offer_expiring
  visitor_quote_received
  visitor_quote_in_review
  visitor_quote_transmitted
  visitor_quote_accepted
  visitor_quote_reassigned
  visitor_quote_closed
  visitor_consent_withdrawn
  visitor_tracking_link
  visitor_proposal_available
  broker_visitor_response
}

enum DeliveryStatus {
  pending
  queued
  sent
  delivered
  failed
  retryable
}

enum QueueJobStatus {
  queued
  active
  completed
  failed
  retryable
  discarded
}

enum QueueJobType {
  notification
  document_hook
  future_ia
  future_routing
  maintenance
  visitor_quote_notification
  broker_lead_notification
  ai_quote_summary
  quote_manual_review
}

enum OfferStatus {
  draft
  review
  validated
  active
  suspended
  expired
  retired
}

enum OfferValidationStatus {
  pending
  validated
  rejected
}

enum QuoteFormStatus {
  draft
  published
  suspended
  retired
}

enum QuoteRequestStatus {
  draft_refused
  created
  manual_review
  routed
  non_routable
  duplicate
  spam_blocked
  cancelled
}

enum RoutingStatus {
  not_started
  eligible
  assigned
  blocked
  no_broker_available
  manual_review_required
  pending_manual_assignment
}

enum RoutingRuleMode {
  first_eligible
  round_robin
  priority
  capacity
  performance
  exclusive
  manual
  multi_send
}

enum RoutingRuleStatus {
  active
  disabled
}

enum ScoringRuleStatus {
  active
  disabled
}

enum QuoteDocumentScanStatus {
  pending
  clean
  infected
  failed
}

enum QuoteDocumentStatus {
  uploaded
  available
  quarantined
  removed
}

model QuoteRequestDocument {
  id                     String                  @id @default(uuid())
  quoteRequestId         String
  prospectId             String?
  label                  String
  documentKind           String
  fileName               String
  mimeType               String
  sizeBytes              Int
  checksum               String
  storageKey             String
  scanStatus             QuoteDocumentScanStatus @default(pending)
  scanEngine             String?
  scanSignature          String?
  scannedAt              DateTime?
  status                 QuoteDocumentStatus     @default(uploaded)
  sharedLeadAssignmentId String?
  sharedAt               DateTime?
  retentionUntil         DateTime
  anonymizedAt           DateTime?
  anonymizationBatchId   String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([quoteRequestId, createdAt])
  @@index([scanStatus, createdAt])
}

model ScoringRule {
  id          String            @id @default(uuid())
  countryId   String?
  productId   String?
  weights     Json
  status      ScoringRuleStatus @default(active)
  description String?
  version     Int               @default(1)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  createdById String?

  @@index([countryId, productId, status])
}

enum DuplicateStatus {
  not_checked
  unique
  possible_duplicate
  blocked_duplicate
}

enum LeadAssignmentStatus {
  assigned
  broker_notified
  seen
  accepted
  received
  contacted
  rejected
  closed
  disputed
}

enum BrokerCrmPipelineStatus {
  nouveau
  accepte
  contact_tente
  contacte
  qualifie
  documents_demandes
  devis_en_preparation
  devis_envoye
  negociation
  gagne
  perdu
  doublon
  injoignable
  hors_cible
  rejete_conteste
}

enum BrokerCrmUrgency {
  low
  normal
  high
  urgent
}

enum AIStatus {
  disabled
  internal_test
  enabled
}

enum GuardrailStatus {
  not_configured
  configured
  failed_review
  approved
}

enum AuditPolicy {
  metadata_only
  full_prompt_metadata
  sensitive_human_validation
}

enum HumanValidationStatus {
  not_required
  pending
  approved
  rejected
}

enum PartnerApiKeyStatus {
  active
  revoked
}

enum PartnerWebhookEndpointStatus {
  disabled
  active
  suspended
}

enum PartnerWebhookDeliveryStatus {
  skipped
  pending
  retryable
  delivered
  failed
  dead_letter
}

enum PartnerWebhookAllowlistStatus {
  active
  revoked
}

enum PartnerWebhookEventType {
  lead_assigned
  lead_status_changed
  notification_failed
}

enum WaitlistEntryStatus {
  active
  unsubscribed
  notified
}

enum PartnerApplicationStatus {
  received
  under_review
  accepted
  rejected
}

enum ContactAudience {
  visitor
  broker
  insurer
  press
}

enum ContactMessageStatus {
  new
  handled
  spam
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  phone           String?
  displayName     String
  status          UserStatus @default(invited)
  mfaStatus       MfaStatus  @default(required)
  lastLoginAt     DateTime?
  passwordHash    String?
  passwordChangedAt DateTime?
  passwordChangeRequired Boolean @default(true)
  failedLoginCount Int @default(0)
  lastFailedLoginAt DateTime?
  lockedAt       DateTime?
  lockedReason   String?
  mfaSecretEncrypted String?
  mfaSecretIssuedAt DateTime?
  mfaBackupCodesHashes String[] @default([])
  passwordResetTokenHash String?
  passwordResetTokenExpiresAt DateTime?
  deletedAt      DateTime?
  lastLoginIpHash String?
  partnerTenantId String?
  countryScopes   String[]
  productScopes   String[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  createdById     String?

  userRoles UserRole[]

  @@index([deletedAt])
}

model Role {
  id           String   @id @default(uuid())
  key          String   @unique
  name         String
  description  String
  isSystemRole Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id          String               @id @default(uuid())
  resource    String
  action      String
  scopeType   FeatureFlagScopeType
  isSensitive Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  rolePermissions RolePermission[]

  @@unique([resource, action, scopeType])
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  reason    String
  createdAt DateTime @default(now())
  createdById String?

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model PartnerTenant {
  id                String         @id @default(uuid())
  legalName         String
  tradeName         String?
  city              String?
  registrationNumber String?
  plan              PartnerPlan    @default(starter)
  status            PartnerStatus  @default(draft)
  suspensionReason  String?
  primaryEmail      String
  primaryWhatsApp   String
  quotaMonthlyLeads Int            @default(0)
  capacityStatus    CapacityStatus @default(available)
  /// Spec 051 R8: primary country (Admin Pays scope), contacts, insurers, contractual SLA, lifecycle.
  countryId              String?
  adminContactName       String?
  adminContactEmail      String?
  adminContactPhone      String?
  commercialContactName  String?
  commercialContactEmail String?
  commercialContactPhone String?
  partnerInsurers        String[]       @default([])
  slaTargetMinutes       Int?
  statusReason           String?
  previousActiveStatus   PartnerStatus?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  createdById       String?

  /// The partial unique index "PartnerTenant_countryId_registrationNumber_key" on (countryId,
  /// registrationNumber) WHERE both are NOT NULL is managed in SQL (migration 0021): Prisma cannot
  /// express it, and a regenerated migration must never drop it (guarded by prisma-migrations.spec.ts).
  @@index([countryId, status])
}

/// Spec 053 R3: broker self-service requests decided by the admin: identity changes (legal name,
/// trade name, RCCM, country) and coverage extensions (one country or one product).
enum PartnerChangeRequestType {
  profile_change
  coverage_extension
}

enum PartnerChangeRequestStatus {
  pending
  accepted
  rejected
  cancelled
}

model PartnerChangeRequest {
  id               String                     @id @default(uuid())
  partnerTenantId  String
  type             PartnerChangeRequestType
  status           PartnerChangeRequestStatus @default(pending)
  requestedChanges Json
  previousValues   Json                       @default("{}")
  justification    String
  requestedById    String?
  decidedById      String?
  decidedAt        DateTime?
  decisionReason   String?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @default(now())

  @@index([partnerTenantId, status])
  @@index([status, createdAt])
}

/// Spec 051 R2: every partner status transition, with its reason and actor.
model PartnerStatusHistory {
  id              String         @id @default(uuid())
  partnerTenantId String
  fromStatus      PartnerStatus?
  toStatus        PartnerStatus
  reason          String
  actorId         String?
  createdAt       DateTime       @default(now())

  @@index([partnerTenantId, createdAt])
}

/// Spec 051 R4: every licence status change.
model PartnerLicenseHistory {
  id              String         @id @default(uuid())
  licenseId       String
  partnerTenantId String
  fromStatus      LicenseStatus?
  toStatus        LicenseStatus
  reason          String
  actorId         String?
  createdAt       DateTime       @default(now())

  @@index([licenseId, createdAt])
  @@index([partnerTenantId, createdAt])
}

/// Spec 051 R6: partnership contract signed outside the platform and recorded by an admin.
model PartnerContract {
  id              String   @id @default(uuid())
  partnerTenantId String
  version         String
  signedAt        DateTime
  signatoryName   String
  documentId      String
  recordedById    String?
  createdAt       DateTime @default(now())

  @@unique([partnerTenantId, version])
}

model PartnerCountryAuthorization {
  id              String   @id @default(uuid())
  partnerTenantId String
  countryId       String
  /// Spec 051 R7: `active` or `withdrawn` (written by the application).
  status          String   @default("pending")
  withdrawnAt      DateTime?
  withdrawalReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdById     String?

  @@unique([partnerTenantId, countryId])
}

model PartnerProductAuthorization {
  id              String   @id @default(uuid())
  partnerTenantId String
  productId       String
  /// Spec 051 R7: `active` or `withdrawn` (written by the application).
  status          String   @default("pending")
  withdrawnAt      DateTime?
  withdrawalReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdById     String?

  @@unique([partnerTenantId, productId])
}

model RegulatoryRegime {
  id                              String       @id @default(uuid())
  key                             String       @unique
  name                            String
  description                     String?
  retentionOverrideYears          Int?
  requiresManualActivationReview  Boolean      @default(false)
  status                          RegimeStatus @default(draft)
  createdAt                       DateTime     @default(now())
  updatedAt                       DateTime     @updatedAt
  createdById                     String?
}

model Country {
  id                 String           @id @default(uuid())
  isoCode            String           @unique
  name               String
  currency           String
  languages          String[]
  timezone           String
  regulatoryFamily   RegulatoryFamily
  regulatoryRegimeId String?
  /// Spec 050 R8: international dialling code (for example +225); null keeps the generic normalisation.
  phoneDialCode        String?
  /// Spec 050 R8: accepted national number lengths (for example [10]); empty keeps the generic normalisation.
  phoneNationalLengths Int[]            @default([])
  status             CountryStatus    @default(draft)
  flags              Json
  /// Spec 046: first transition to `public`; anchors the waiting-list retention.
  publicSince        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  createdById        String?
}

model ProductCategory {
  id        String                @id @default(uuid())
  key       String                @unique
  name      String
  status    ProductCategoryStatus @default(draft)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  createdById String?
}

model Product {
  id                   String             @id @default(uuid())
  categoryId           String?
  key                  String             @unique
  name                 String
  description          String?
  sensitivity          ProductSensitivity @default(standard)
  requiresDocuments    Boolean            @default(false)
  requiresManualReview Boolean            @default(true)
  status               ProductStatus      @default(draft)
  flags                Json
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  createdById          String?
}

model CountryProduct {
  id          String   @id @default(uuid())
  countryId   String
  productId   String
  status      String   @default("internal")
  flags       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  @@unique([countryId, productId])
}

model PartnerLicense {
  id              String        @id @default(uuid())
  partnerTenantId String
  licenseNumber   String
  issuingAuthority String
  countryId       String
  productIds      String[]
  status          LicenseStatus @default(draft)
  effectiveDate   DateTime
  expirationDate  DateTime
  validatedById   String?
  validatedAt     DateTime?
  /// Spec 051 R4: reason of the last status change and the licence this one renews.
  statusReason    String?
  renewsLicenseId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdById     String?
}

model AccreditationDocument {
  id              String         @id @default(uuid())
  partnerTenantId String
  licenseId       String?
  documentType    DocumentType
  storageKey      String
  checksum        String
  status          DocumentStatus @default(uploaded)
  expirationDate  DateTime?
  reviewedById    String?
  reviewedAt      DateTime?
  /// Spec 051 R5: uploaded file metadata, antivirus verdict and review reason.
  fileName        String?
  mimeType        String?
  sizeBytes       Int?
  scanStatus      AccreditationScanStatus @default(pending)
  scanEngine      String?
  scannedAt       DateTime?
  reviewReason    String?
  retentionUntil  DateTime
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  createdById     String?
}

model FeatureFlag {
  id           String               @id @default(uuid())
  key          String
  scopeType    FeatureFlagScopeType
  scopeId      String?
  value        Boolean              @default(false)
  defaultValue Boolean              @default(false)
  reason       String
  changedById  String?
  changedAt    DateTime             @default(now())
  cacheVersion Int                  @default(1)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([key, scopeType, scopeId])
}

model FeatureFlagHistory {
  id            String               @id @default(uuid())
  featureFlagId String
  key           String
  scopeType     FeatureFlagScopeType
  scopeId       String?
  previousValue Boolean
  nextValue     Boolean
  reason        String
  changedById   String?
  changedAt     DateTime             @default(now())
}

model ConsentText {
  id                String            @id @default(uuid())
  purpose           ConsentPurpose
  countryId         String
  productId         String?
  channel           ConsentChannel
  recipientCategory String
  language          String
  version           String
  status            ConsentTextStatus @default(draft)
  contentHash       String
  /// Spec 050 R5: full template (variables unresolved); the hash is computed from it by the server.
  content           String?
  publishedAt       DateTime?
  retiredAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  createdById       String?

  @@unique([purpose, countryId, productId, channel, language, version])
}

model ConsentRecord {
  id                String              @id @default(uuid())
  consentTextId     String
  subjectReference  String
  purpose           ConsentPurpose
  countryId         String
  productId         String?
  channel           ConsentChannel
  intendedRecipient String
  status            ConsentRecordStatus @default(granted)
  grantedAt         DateTime            @default(now())
  withdrawnAt       DateTime?
  retentionUntil    DateTime
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  createdById       String?
}

model AuditLog {
  id             String      @id @default(uuid())
  actorId        String?
  action         String
  targetType     String
  targetId       String
  scope          Json
  result         AuditResult
  reason         String?
  context        Json
  correlationId  String?
  occurredAt     DateTime    @default(now())
  retentionUntil DateTime
  createdAt      DateTime    @default(now())
}

model Notification {
  id                String           @id @default(uuid())
  type              NotificationType
  recipientScope    String
  whatsAppStatus    DeliveryStatus   @default(pending)
  emailStatus       DeliveryStatus   @default(pending)
  payloadReference  String
  relatedAuditLogId String?
  queueJobRecordId  String?
  lastAttemptAt     DateTime?
  retryCount        Int              @default(0)
  /// Spec 054 R3: persisted idempotency key `{type}:{quoteRequestId}:{assignmentId|-}:{seq}`.
  dedupeKey         String?          @unique
  /// Spec 054 R3: non-sensitive identifiers of the event (assignment and partner ids).
  eventPayload      Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  createdById       String?
}

model QueueJobRecord {
  id             String         @id @default(uuid())
  queueName      String
  jobType        QueueJobType
  status         QueueJobStatus @default(queued)
  failureReason  String?
  retryCount     Int            @default(0)
  correlationId  String?
  visibleToRoles String[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  createdById    String?
}

model AIModuleConfig {
  id                      String          @id @default(uuid())
  key                     String          @unique
  status                  AIStatus        @default(disabled)
  allowedScopes           Json
  promptTemplateReference String?
  guardrailStatus         GuardrailStatus @default(not_configured)
  auditPolicy             AuditPolicy     @default(metadata_only)
  quotaPolicyReference    String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  createdById             String?
}

model AIInteraction {
  id                    String                @id @default(uuid())
  moduleConfigId         String
  actorId                String?
  scope                  Json
  minimizedInputReference String
  outputReference        String
  guardrailResult        String
  humanValidationStatus  HumanValidationStatus @default(not_required)
  occurredAt             DateTime              @default(now())
  createdAt              DateTime              @default(now())
  assistType             String                @default("unknown")
  surface                String                @default("admin_platform")
  status                 String                @default("queued")
  provider               String                @default("template")
  model                  String?
  fallback               Boolean               @default(false)
  promptHash             String?
  outputHash             String?
  outputText             String?
  outputData             Json?
  refusalReason          String?
  minimizationReport     Json?
  inputTokens            Int?
  outputTokens           Int?
  latencyMs              Int?
  targetType             String?
  targetId               String?
  partnerTenantId        String?
  countryId              String?
  productId              String?
  correlationId          String?
  completedAt            DateTime?
  updatedAt              DateTime              @default(now()) @updatedAt

  @@index([surface, status, createdAt])
  @@index([partnerTenantId, assistType, createdAt])
  @@index([targetType, targetId])
}

model RoutingPrecheck {
  id              String   @id @default(uuid())
  countryId       String
  productId       String
  partnerTenantId String
  consentStatus   String
  countryStatus   String
  productStatus   String
  partnerStatus   String
  licenseStatus   String
  quotaStatus     String
  result          String
  reasons         String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdById     String?
}

model Offer {
  id                  String                @id @default(uuid())
  countryId           String
  productId           String
  partnerTenantId     String?
  publicKey           String
  name                String
  shortDescription    String?
  guaranteeSummary    String?
  indicativePriceMin  Decimal?
  indicativePriceMax  Decimal?
  currency            String
  pricingUnit         String?
  status              OfferStatus          @default(draft)
  validationStatus    OfferValidationStatus @default(pending)
  validFrom           DateTime
  validUntil          DateTime
  isSponsored         Boolean               @default(false)
  sponsorLabel        String?
  displayPriority     Int                   @default(0)
  publicDisclaimers   String[]
  insurerName         String?
  guaranteeLevel      Int?
  deductibleAmount    Decimal?
  coverageCeiling     Decimal?
  processingDelayDays Int?
  paymentFlexibility  String?
  guarantees          Json                  @default("[]")
  exclusionsSummary   String?
  requiredDocuments   String[]              @default([])
  sourceOfInformation String?
  validatedById       String?
  validatedAt         DateTime?
  /// Spec 052 R1: the columns above hold the published version only (or v1 of a never published offer).
  publishedVersionId  String?
  pendingVersionId    String?
  /// Spec 052: `indicative` or `partner`.
  offerType           String                @default("indicative")
  withdrawnAt         DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  createdById         String?

  @@unique([countryId, productId, publicKey])
  @@index([countryId, productId, status, validationStatus, validFrom, validUntil])
}

enum OfferVersionStatus {
  draft
  submitted
  published
  archived
  withdrawn
}

/// Spec 052 R1/R2: every version of an offer. At most one `published` and one `draft|submitted`
/// version per offer, enforced by the partial unique indexes `OfferVersion_offerId_published_key`
/// and `OfferVersion_offerId_pending_key` of migration 0022 (Prisma cannot express them).
model OfferVersion {
  id                  String             @id @default(uuid())
  offerId             String
  versionNumber       Int
  status              OfferVersionStatus @default(draft)
  name                String
  shortDescription    String?
  guaranteeSummary    String?
  exclusionsSummary   String?
  insurerName         String?
  guarantees          Json               @default("[]")
  guaranteeLevel      Int?
  deductibleAmount    Decimal?
  coverageCeiling     Decimal?
  processingDelayDays Int?
  paymentFlexibility  String?
  requiredDocuments   String[]           @default([])
  sourceOfInformation String?
  indicativePriceMin  Decimal?
  indicativePriceMax  Decimal?
  currency            String
  pricingUnit         String?
