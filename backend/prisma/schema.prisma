/// Spec 054 R1: visitor access tokens. Only the SHA-256 of the token is stored; the clear token is
/// shown once (confirmation screen, e-mail link) and compared in constant time.
model VisitorAccessToken {
  id             String    @id @default(uuid())
  quoteRequestId String
  tokenHash      String    @unique
  purpose        String    @default("tracking")
  issuedAt       DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([quoteRequestId, expiresAt])
}

