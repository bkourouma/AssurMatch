/// Spec 055: the broker's indicative, non-contractual proposal to the visitor. Immutable once sent:
/// only the lifecycle columns (viewedAt, respondedAt, withdrawnAt, status) change afterwards.
/// `partnerTenantId` is the broker that sent it; after a reassignment it differs from the
/// assignment's partner and the proposal is closed for responses.
model LeadProposal {
  id                 String    @id @default(uuid())
  leadAssignmentId   String
  quoteRequestId     String
  partnerTenantId    String
  authorId           String?
  channel            String    @default("crm")
  status             String    @default("sent")
  message            String
  priceMin           Decimal?  @db.Decimal(16, 2)
  priceMax           Decimal?  @db.Decimal(16, 2)
  currency           String    @default("XOF")
  guarantees         String[]
  validUntil         DateTime
  nonContractual     Boolean   @default(true)
  documentStorageKey String?
  documentFileName   String?
  documentMimeType   String?
  documentSizeBytes  Int?
  documentChecksum   String?
  documentScanStatus String?
  documentScanEngine String?
  documentScannedAt  DateTime?
  sentAt             DateTime  @default(now())
  viewedAt           DateTime?
  respondedAt        DateTime?
  withdrawnAt        DateTime?
  withdrawnById      String?
  withdrawReason     String?
  anonymizedAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([leadAssignmentId, sentAt])
  @@index([quoteRequestId, sentAt])
  @@index([partnerTenantId, sentAt])
}

