// Public-site forms (waitlist, broker application, contact). All three keep a normalized
// address plus its fingerprint for deduplication, never a reversible contact hash of the IP,
// and carry an explicit retention horizon like every other evidence-bearing table.
model WaitlistEntry {
  id              String              @id @default(uuid())
  countryId       String
  productId       String?
  emailNormalized String
  emailFingerprint String
  consentVersion  String
  status          WaitlistEntryStatus @default(active)
  ipHash          String?
  source          String              @default("public_web")
  retentionUntil  DateTime
  anonymizedAt    DateTime?
  anonymizationBatchId String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([countryId, emailFingerprint])
  @@index([countryId, status, createdAt])
}

