  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([audience, status, createdAt])
}

enum AnonymizationBatchKind {
  retention
  erasure
}

enum AnonymizationBatchStatus {
  previewed
  executed
  refused
  expired
  interrupted
}

/// Spec 046 D1: an override of a code default retention duration, global (countryId null) or per country.
/// The partial unique index "RetentionPolicy_global_category_key" on (category) WHERE countryId IS NULL is
/// managed in SQL (migration 0018): Prisma cannot express it, so `prisma migrate diff` will not show it
/// and a regenerated migration must never drop it (guarded by prisma-migrations.spec.ts).
model RetentionPolicy {
  id            String   @id @default(uuid())
  countryId     String?
  category      String
  retentionDays Int
  reason        String
  updatedById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([countryId, category])
}

/// Spec 046 D2/D3: the durable proof of an anonymization. Stores target row ids only, never an
/// e-mail address, a phone number or a fingerprint.
model AnonymizationBatch {
  id               String                   @id @default(uuid())
  kind             AnonymizationBatchKind
  status           AnonymizationBatchStatus @default(previewed)
  countryId        String?
  categories       String[]
  erasureLookup    String?
  reason           String
  requestedById    String?
  approvedById     String?
  approvalReason   String?
  targets          Json
  counts           Json
  previewExpiresAt DateTime
  approvedAt       DateTime?
  executedAt       DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([status, createdAt])
}


enum SatisfactionSurveyStatus {
  queued
  sent
  submitted
  skipped
  expired
}

