# AssurMatch PRODUCTION — worker container (spec 057, PRD I-01, decision D-7). NEVER commit a filled copy.
# On the host: /home/deployer/apps/assurmatch/env/worker.env, owner deployer, mode 0600.
# The worker runs the API image with scripts/worker/assurmatch-worker.ts. It loads the same
# runtime as the API, so it needs the API's data stores, secrets, e-mail and link settings; it
# serves no HTTP and needs no CORS, AI, document or messaging settings.

NODE_ENV=production
APP_ENV=production

DATABASE_URL=REDACTED
REDIS_URL=redis://redis:6379
ASSURMATCH_AUTH_TOKEN_SECRET=REDACTED
ENCRYPTION_KEY=REDACTED
# Lot 8 (spec 075): same PII keys as the API (the worker reads prospects and quote answers).
# Boot fails without them; see docs/runbooks/pii-encryption.md.
PII_ENCRYPTION_KEYS=
PII_ENCRYPTION_ACTIVE_KEY_ID=
PII_BLIND_INDEX_KEY=

# Links written into the e-mails the worker sends.
APP_BASE_URL=https://admin.<domain>
PUBLIC_APP_URL=https://<domain>
BROKER_APP_URL=https://pro.<domain>

# Same provider as the API. EMAIL_PREVIEW_MODE=true records the e-mail without sending it.
EMAIL_SERVICE_TYPE=smtp
EMAIL_FROM=no-reply@<domain>
EMAIL_REPLY_TO=support@<domain>
EMAIL_SMTP_HOST=REDACTED
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=REDACTED
EMAIL_SMTP_PASS=REDACTED
EMAIL_SEND_TIMEOUT_MS=5000
EMAIL_PREVIEW_MODE=true

# --- Loop -----------------------------------------------------------------------------------------
# Seconds between two cycles (5..3600). Cycles never overlap.
ASSURMATCH_WORKER_INTERVAL_SECONDS=30
# Max wait for the in-flight cycle on SIGTERM before a forced exit (keep below compose stop_grace_period).
ASSURMATCH_WORKER_SHUTDOWN_TIMEOUT_SECONDS=25
ASSURMATCH_WORKER_HEARTBEAT_FILE=/tmp/assurmatch-worker.heartbeat
# Healthcheck threshold; default 3 x interval + 60 s.
ASSURMATCH_WORKER_HEARTBEAT_MAX_AGE_SECONDS=150

# Batch sizes per cycle (1..100).
ASSURMATCH_QUOTE_NOTIFICATION_DELIVERY_LIMIT=25
ASSURMATCH_SATISFACTION_SURVEY_DELIVERY_LIMIT=50
ASSURMATCH_PARTNER_WEBHOOK_DELIVERY_LIMIT=25

# Spec 067 (lot 1): single "missing documents" reminder e-mail to the visitor (pointer e-mail, own
# unsubscribe purpose). On unless set to false. Delay in days after the document request opened
# (1..30, default 3) and minimum minutes between two scans (1..1440, default 60).
ASSURMATCH_DOCUMENT_REMINDERS_ENABLED=true
ASSURMATCH_DOCUMENT_REMINDER_DAYS=3
ASSURMATCH_DOCUMENT_REMINDER_INTERVAL_MINUTES=60

# Partner webhooks are delivered only when this is true AND the partner_webhooks_enabled flag is
# on. Leave false at launch: the task is then not scheduled at all.
ASSURMATCH_PARTNER_WEBHOOK_DELIVERY_ENABLED=false

# Lot 10 (spec 076): generic outbound CRM connector. Delivered only when this is true AND the
# crm_connector_enabled flag is on (compliance policy only). Leave false at launch: not scheduled.
ASSURMATCH_CRM_CONNECTOR_DELIVERY_ENABLED=false
ASSURMATCH_CRM_CONNECTOR_DELIVERY_LIMIT=25
# SMS / WhatsApp retries (the queue is inert while no message failed). The worker also needs the
# ASSURMATCH_SMS_* / ASSURMATCH_WHATSAPP_* provider variables of the API (see .env.production.api.example).
ASSURMATCH_CHANNEL_OUTBOX_LIMIT=25
# Provider variables (leave empty while the SMS / WhatsApp flags are closed). Without them, due
# retries are kept in the queue (deferred), never erased.
# ASSURMATCH_SMS_PROVIDER=
# ASSURMATCH_SMS_API_KEY=
# ASSURMATCH_SMS_API_URL=
# ASSURMATCH_SMS_SENDER=
# ASSURMATCH_SMS_ACCOUNT_ID=
# ASSURMATCH_WHATSAPP_PROVIDER=
# ASSURMATCH_WHATSAPP_API_KEY=
# ASSURMATCH_WHATSAPP_PHONE_NUMBER_ID=
# ASSURMATCH_WHATSAPP_API_BASE_URL=
# ASSURMATCH_WHATSAPP_TEMPLATE_NAME=
# ASSURMATCH_WHATSAPP_TEMPLATE_LANGUAGE=

# Spec 058: optional Uptime Kuma "Push" monitor URL (https://<kuma>/api/push/<token>). Pushed after
# every cycle (status=down when a task failed). The URL is a credential: never logged. Empty: off.
ASSURMATCH_WORKER_PUSH_URL=
# Lot 8 (spec 075): audit integrity, see docs/runbooks/audit-integrity.md
AUDIT_INTEGRITY_KEYS=
AUDIT_INTEGRITY_ACTIVE_KEY_ID=
ASSURMATCH_AUDIT_OUTBOX_MAX=2000
