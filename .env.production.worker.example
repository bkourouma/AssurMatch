# AssurMatch PRODUCTION — worker container (spec 057, PRD I-01, decision D-7). NEVER commit a filled copy.
# On the host: /home/deployer/apps/assurmatch/env/worker.env, owner deployer, mode 0600.
# The worker runs the API image with scripts/worker/assurmatch-worker.ts. It loads the same
# runtime as the API, so it needs the API's data stores, secrets, e-mail and link settings; it
# serves no HTTP and needs no CORS, AI, document or messaging settings.

NODE_ENV=production
APP_ENV=production

DATABASE_URL=REDACTED
REDIS_URL=redis://redis:6379
ASSURMATCH_AUTH_TOKEN_SECRET=REDACTED
ENCRYPTION_KEY=REDACTED

# Links written into the e-mails the worker sends.
APP_BASE_URL=https://admin.<domain>
PUBLIC_APP_URL=https://<domain>
BROKER_APP_URL=https://pro.<domain>

# Same provider as the API. EMAIL_PREVIEW_MODE=true records the e-mail without sending it.
EMAIL_SERVICE_TYPE=smtp
EMAIL_FROM=no-reply@<domain>
EMAIL_REPLY_TO=support@<domain>
EMAIL_SMTP_HOST=REDACTED
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=REDACTED
EMAIL_SMTP_PASS=REDACTED
EMAIL_SEND_TIMEOUT_MS=5000
EMAIL_PREVIEW_MODE=true

# --- Loop -----------------------------------------------------------------------------------------
# Seconds between two cycles (5..3600). Cycles never overlap.
ASSURMATCH_WORKER_INTERVAL_SECONDS=30
# Max wait for the in-flight cycle on SIGTERM before a forced exit (keep below compose stop_grace_period).
ASSURMATCH_WORKER_SHUTDOWN_TIMEOUT_SECONDS=25
ASSURMATCH_WORKER_HEARTBEAT_FILE=/tmp/assurmatch-worker.heartbeat
# Healthcheck threshold; default 3 x interval + 60 s.
ASSURMATCH_WORKER_HEARTBEAT_MAX_AGE_SECONDS=150

# Batch sizes per cycle (1..100).
ASSURMATCH_QUOTE_NOTIFICATION_DELIVERY_LIMIT=25
ASSURMATCH_SATISFACTION_SURVEY_DELIVERY_LIMIT=50
ASSURMATCH_PARTNER_WEBHOOK_DELIVERY_LIMIT=25

# Partner webhooks are delivered only when this is true AND the partner_webhooks_enabled flag is
# on. Leave false at launch: the task is then not scheduled at all.
ASSURMATCH_PARTNER_WEBHOOK_DELIVERY_ENABLED=false
